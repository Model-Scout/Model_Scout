# Stage 1 resume checkpoints are transient and are not corpus snapshots.
ai/data/.stage1_v*_checkpoint/

# Local analysis and editor metadata.
graphify-out/
.serena/

# Retrieval lab: BGE-M3 index build checkpoints (resumable, removed after a full build).
ai/data/retrieval_lab/.bge_m3_build/

# Planning doc page renders (local only).
png/

# Public-portal raw catalog cache (data.go.kr list is 160MB+); re-downloaded by 18_collect_public_datasets.py --refresh.
# The official-page look-ups behind the frozen v2 (answers, migrations, stored pages) are kept: they are its evidence.
ai/data/public_catalog/*
!ai/data/public_catalog/official_meta.jsonl
!ai/data/public_catalog/official_meta_migrations.json
!ai/data/public_catalog/official_raw/

# Dataset vectors live in Supabase (20_sync_dataset_index.py); 14 --embed rebuilds this file from there.
ai/data/dataset_index/embeddings.npy
ai/data/dataset_index/embeddings.npy

# LLM wiki (Obsidian vault) is generated by 15_build_wiki.py (v2 -> wiki_v2/, v1 -> wiki/); .tmp is its staging folder.
ai/wiki/
ai/wiki_v2/
ai/wiki.tmp/
ai/wiki_v2.tmp/

# Corpus v2: the frozen build is committed (enrichment, graph, documents, vector record). Its vectors
# (126 MB, over GitHub's file limit) live in the v2 tables: 20_sync_dataset_index.py --corpus v2 --restore-vectors.
ai/data/dataset_index_v2/embeddings.npy

# Model reingest run outputs (08 --report / --bundle-dir). Uploaded as Action artifacts, never committed.
ai/reingest-bundle/
ai/reingest-work/
ai/reingest-report*.json
ai/reingest-coverage-*.md
# Earlier v2 vectors, kept outside git (the pin record is test/public_data/corpus_v2/pins/)
ai/data/archive/
# Detail pages behind the API evidence (~47 KB each); the evidence and page hash stay in official_meta.jsonl
ai/data/public_catalog/official_raw/*.page.gz

# Local release builds and validation keys (deploy/release.sh): never committed.
deploy/.releases/
deploy/.local/ai.env
