{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Model-Scout/Model_Scout/ai/contract/model-record.schema.json",
  "title": "Model Scout ModelRecord",
  "description": "모델 한 건이 반드시 가져야 하는 사실의 정식 정의. 사람이 읽는 규약은 contract/README.md. 값은 평평하게 두고 출처는 provenance.fields 한 곳에 모은다 — 하드 필터가 값을 직접 읽어야 하므로 모든 필드를 {value, status} 객체로 감싸지 않는다.",
  "type": "object",
  "required": ["model_id", "identity", "discovery", "capability", "technical", "artifacts", "deployment", "legal", "quality", "semantic", "provenance"],
  "additionalProperties": true,

  "properties": {
    "model_id": { "type": "string", "minLength": 1, "pattern": "^[^/]+/[^/]+$|^[^/]+$" },

    "identity": {
      "type": "object",
      "description": "모델을 가리키고, 나중에 같은 것을 다시 볼 수 있게 하는 정보.",
      "required": ["model_id", "author", "repo_url", "revision", "last_modified", "gated", "private"],
      "additionalProperties": false,
      "properties": {
        "model_id":      { "type": "string" },
        "author":        { "type": ["string", "null"] },
        "repo_url":      { "type": ["string", "null"], "format": "uri" },
        "revision":      { "type": ["string", "null"], "description": "커밋 SHA. 이 값이 없으면 '어느 버전을 보고 판정했는지' 재현할 수 없다." },
        "last_modified": { "type": ["string", "null"], "format": "date-time" },
        "gated":         { "type": ["string", "boolean", "null"], "description": "HF의 gated 값. false | 'auto' | 'manual'. null은 미수집이며 Q7에 답할 수 없다는 뜻이다." },
        "private":       { "type": ["boolean", "null"] }
      }
    },

    "discovery": {
      "type": "object",
      "description": "왜 이 모델이 코퍼스에 들어왔는지, 그리고 중복 관계.",
      "required": ["candidate_tier", "candidate_type", "korean_evidence", "downloads", "likes", "popularity_tier", "canonical_model_id", "is_variant", "variant_types", "source_pool"],
      "additionalProperties": false,
      "properties": {
        "candidate_tier":     { "type": ["string", "null"] },
        "candidate_type":     { "type": ["string", "null"] },
        "korean_evidence":    { "type": "array", "items": { "type": "string" } },
        "downloads":          { "type": ["integer", "null"], "minimum": 0 },
        "likes":              { "type": ["integer", "null"], "minimum": 0 },
        "popularity_tier":    { "type": ["string", "null"] },
        "canonical_model_id": { "type": ["string", "null"], "description": "이 모델의 원본. 자신이 원본이면 자기 자신. dedupe_canonical이 같은 원본의 변종을 하나만 남긴다." },
        "is_variant":         { "type": "boolean" },
        "variant_types":      { "type": "array", "items": { "type": "string" } },
        "source_pool":        { "enum": ["core", "low_popularity"] }
      }
    },

    "capability": {
      "type": "object",
      "description": "무엇을 하는 모델인지. Q4·Q5가 여기에 의존한다.",
      "required": ["primary_task", "matched_tasks", "languages", "korean_verified", "multilingual_verified", "translation_pairs", "modality", "embedding_dimensions", "reranker"],
      "additionalProperties": false,
      "properties": {
        "primary_task":          { "type": ["string", "null"] },
        "matched_tasks":         { "type": "array", "items": { "type": "string" } },
        "languages":             { "type": "array", "items": { "type": "string" } },
        "korean_verified":       { "type": ["boolean", "null"] },
        "multilingual_verified": { "type": ["boolean", "null"] },
        "translation_pairs":     { "type": "array", "items": { "type": "string" }, "description": "'ko-en' 꼴. Q5는 컨텍스트 길이와 번역 방향을 둘 다 확인해야 답이 된다." },
        "modality":              { "type": "array", "items": { "enum": ["text", "image", "audio", "video"] } },
        "embedding_dimensions":  { "type": ["integer", "null"], "minimum": 1 },
        "reranker":              { "type": ["boolean", "null"] }
      }
    },

    "technical": {
      "type": "object",
      "description": "크기와 구조. Q2가 여기에 의존한다.",
      "required": ["architecture", "model_type", "parameter_count_total", "parameter_count_active", "context_length", "dtype"],
      "additionalProperties": false,
      "properties": {
        "architecture":           { "type": "array", "items": { "type": "string" } },
        "model_type":             { "type": ["string", "null"] },
        "parameter_count_total":  { "$ref": "#/$defs/parameter_count", "description": "전체 파라미터. VRAM은 이 기준." },
        "parameter_count_active": { "$ref": "#/$defs/parameter_count", "description": "MoE 활성 파라미터. 속도는 이 기준. 24B-A2B = 전체 24B / 활성 2B. 둘을 구별하지 않으면 '3B 이하' 질의의 답이 뒤집힌다. MoE가 아니면 total과 같다." },
        "context_length":         { "type": ["integer", "null"], "minimum": 128, "maximum": 16777216, "description": "범위 밖 값은 GGUF 헤더 센티넬(2^32-1 등)이므로 받지 않는다." },
        "dtype":                  { "type": ["string", "null"], "description": "float32 | float16 | bfloat16 | int8 | ... 필요 메모리 계산의 바이트/파라미터가 여기서 나온다. 현재 Stage 4가 이 필드를 통째로 버리고 있다." }
      }
    },

    "artifacts": {
      "type": "object",
      "description": "실제로 내려받을 수 있는 파일. 추정이 아닌 측정값이므로 Q2의 1차 근거다.",
      "required": ["formats", "file_count", "total_bytes"],
      "additionalProperties": false,
      "properties": {
        "file_count":  { "type": ["integer", "null"], "minimum": 0 },
        "total_bytes": { "type": ["integer", "null"], "minimum": 0, "description": "레포 전체 파일 크기 합. blobs=true로 받은 siblings.size의 합이다." },
        "formats": {
          "type": "object",
          "description": "포맷별 상세. 키는 고정이며 없는 포맷도 present:false로 존재한다.",
          "required": ["safetensors", "gguf", "onnx", "pytorch_bin", "ct2", "mlx"],
          "additionalProperties": false,
          "patternProperties": {
            "^(safetensors|gguf|onnx|pytorch_bin|ct2|mlx)$": { "$ref": "#/$defs/artifact_format" }
          }
        }
      }
    },

    "deployment": {
      "type": "object",
      "description": "어디서 돌아가나. Q3가 여기에 의존한다.",
      "required": ["targets", "vram_estimate"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "object",
          "required": ["cpu", "cuda", "mps", "vllm", "llama_cpp", "onnx"],
          "additionalProperties": false,
          "patternProperties": {
            "^(cpu|cuda|mps|vllm|llama_cpp|onnx)$": { "$ref": "#/$defs/deployment_target" }
          }
        },
        "vram_estimate": {
          "type": "object",
          "description": "가중치만 기준 추정. 사용자는 '16GB에 들어간다'로 읽으므로 basis와 caveat을 반드시 함께 노출한다.",
          "required": ["weights_only", "basis", "caveat"],
          "additionalProperties": false,
          "properties": {
            "weights_only": {
              "type": "object",
              "required": ["fp16_gib", "int8_gib", "int4_gib", "detected_quantization_gib"],
              "additionalProperties": false,
              "patternProperties": {
                "^(fp16_gib|int8_gib|int4_gib|detected_quantization_gib)$": { "type": ["number", "null"], "minimum": 0 }
              }
            },
            "basis":  { "enum": ["parameter_count", "artifact_bytes", null], "description": "무엇에서 계산했나. artifact_bytes가 측정값이므로 더 정확하다." },
            "caveat": { "type": ["string", "null"] }
          }
        }
      }
    },

    "legal": {
      "type": "object",
      "description": "써도 되나. Q1·Q7이 여기에 의존한다. commercial_status는 '저장소가 선언한 라이선스가 어느 계열인가'만 말하고, 법적 안전성·학습 데이터·서비스 운영 방식은 말하지 않는다.",
      "required": ["license_raw", "license_file", "commercial_status", "base_model_constraint", "redistribution", "review_required", "review_reason", "user_message"],
      "additionalProperties": false,
      "properties": {
        "license_raw": {
          "anyOf": [
            { "type": "null" },
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ],
          "description": "HF 태그 원문. 여러 개면 가장 제한적인 것이 commercial_status를 결정한다."
        },
        "license_file": {
          "type": ["object", "null"],
          "description": "LICENSE / LICENSE.md / LICENSE.txt / COPYING / NOTICE 중 발견된 것. 원문을 LLM에 읽혀 자동 판정하지 않는다 — 법적 성격이 있는 판단이고 틀렸을 때 피해가 '모른다'보다 크다. 사람이 읽을 수 있게 모아 두는 데까지가 파이프라인의 일이다.",
          "required": ["path", "sha256", "chars"],
          "additionalProperties": false,
          "properties": {
            "path":   { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "chars":  { "type": "integer", "minimum": 0 }
          }
        },
        "commercial_status": {
          "enum": ["permitted", "prohibited", "review_required", "unknown"],
          "description": "taxonomy.yaml의 commercial_use 패싯에서 유도한다. 매핑 테이블을 새로 만들지 않는다 — 두 벌이 되면 어느 쪽이 맞는지 알 수 없다. commercial→permitted, non_commercial→prohibited, conditional→review_required, unknown/None→unknown."
        },
        "base_model_constraint": {
          "type": ["object", "null"],
          "description": "base_model을 따라간 결과. apache-2.0으로 선언된 Llama 파인튜닝처럼, 원본이 더 제한적인 경우를 잡는다. 값을 덮어쓰지 않고 둘 다 보여준다.",
          "required": ["base_model_id", "commercial_status", "more_restrictive"],
          "additionalProperties": false,
          "properties": {
            "base_model_id":     { "type": "string" },
            "commercial_status": { "enum": ["permitted", "prohibited", "review_required", "unknown"] },
            "more_restrictive":  { "type": "boolean" }
          }
        },
        "redistribution":  { "enum": ["permitted", "restricted", "unknown"] },
        "review_required": { "type": "boolean", "description": "commercial_status가 review_required/unknown이거나 base_model_constraint가 더 제한적일 때 true." },
        "review_reason":   { "type": ["string", "null"] },
        "user_message":    { "type": "string", "minLength": 1, "description": "사용자에게 그대로 보여줄 한 문장. 모든 상태에 대해 비어 있지 않아야 한다 — '모른다'도 할 말이 있다." }
      }
    },

    "quality": {
      "type": "object",
      "description": "성능 근거. Q6은 같은 benchmark·metric 안에서만 비교해야 한다.",
      "required": ["results", "summary"],
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["benchmark", "dataset", "metric", "score", "self_reported", "comparability", "evidence_ref", "ranking_eligible"],
            "additionalProperties": true,
            "properties": {
              "benchmark":        { "type": "string" },
              "dataset":          { "type": ["string", "null"] },
              "metric":           { "type": "string" },
              "score":            { "type": ["number", "null"] },
              "split":            { "type": ["string", "null"] },
              "higher_is_better": { "type": ["boolean", "null"] },
              "self_reported":    { "type": "boolean", "description": "모델 작성자가 자기 카드에 적은 점수인지. 거의 전부 true다. 비교할 때 반드시 표시한다." },
              "comparability":    { "type": "string", "description": "safe_same_source 등. 다른 출처의 점수와 섞어 순위를 내면 안 된다." },
              "evidence_ref":     { "type": "string", "description": "readme:table[1].row[64].column[6] 꼴. 사람이 원문을 찾아갈 수 있어야 한다." },
              "ranking_eligible": { "type": "boolean" }
            }
          }
        },
        "summary": { "type": "object", "additionalProperties": true }
      }
    },

    "semantic": {
      "type": "object",
      "description": "LLM이 README에서 뽑은 설명. **사실 필드가 아니다.** 하드 필터는 이 그룹을 읽지 않는다. 설명과 근거 제시에만 쓴다.",
      "required": ["summary", "strengths", "limitations", "use_cases", "atomic_evidence", "status"],
      "additionalProperties": false,
      "properties": {
        "summary":         { "type": ["string", "null"] },
        "strengths":       { "type": "array", "items": { "type": "string" } },
        "limitations":     { "type": "array", "items": { "type": "string" } },
        "use_cases":       { "type": "array", "items": { "type": "string" } },
        "atomic_evidence": { "type": "array", "items": { "type": "object" } },
        "status":          { "enum": ["completed", "partial", "failed", "skipped"] }
      }
    },

    "provenance": {
      "type": "object",
      "description": "위 전부에 대한 메타. 값이 없어도 필드는 존재하고, 왜 모르는지 여기에 적힌다.",
      "required": ["schema_version", "pipeline_run_id", "retrieved_at", "fields", "conflicts", "review_queue"],
      "additionalProperties": false,
      "properties": {
        "schema_version":  { "type": "integer", "const": 1 },
        "pipeline_run_id": { "type": "string", "minLength": 1, "description": "이 레코드를 만든 재적재 실행 ID. 골든셋 판정과 검색 평가가 같은 run을 쓰는지 확인하는 기준." },
        "retrieved_at":    { "type": "string", "format": "date-time" },
        "fields": {
          "type": "object",
          "description": "계약 필드의 점 경로 → 그 값을 어떻게 알게 됐는지. contract_fields에 적힌 경로는 전부 여기에 있어야 한다.",
          "propertyNames": { "pattern": "^[a-z_]+(\\.[a-z_0-9]+)+$" },
          "additionalProperties": { "$ref": "#/$defs/fact_provenance" }
        },
        "conflicts": {
          "type": "array",
          "description": "출처 둘 이상이 다른 값을 말한 필드. 값을 쓰지 않고 사람이 판정한다.",
          "items": {
            "type": "object",
            "required": ["field", "candidates"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "candidates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["value", "source"],
                  "additionalProperties": false,
                  "properties": {
                    "value":  {},
                    "source": { "$ref": "#/$defs/source_ref" }
                  }
                }
              }
            }
          }
        },
        "review_queue": {
          "type": "array",
          "description": "사람이 외부 공식 문서를 봐야 하는 항목. 아무 블로그가 아니라 현재 저장소 → 공식 base model 저장소 → 공식 조직의 약관 순서만 허용한다.",
          "items": {
            "type": "object",
            "required": ["field", "reason"],
            "additionalProperties": false,
            "properties": {
              "field":  { "type": "string" },
              "reason": { "type": "string" },
              "hint":   { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "parameter_count": {
      "type": ["integer", "null"],
      "minimum": 1000000,
      "maximum": 2000000000000,
      "description": "범위 밖 값은 받지 않는다. 0·-1·2^16-1·2^31-1·2^32-1·2^63-1은 GGUF 헤더 센티넬이다."
    },

    "status": {
      "enum": ["verified", "documented", "inferred", "conflict", "unknown", "not_applicable"],
      "description": "verified=1차 출처를 기계가 판독 / documented=카드·공식 문서에 명시 / inferred=확정값에서 유도 / conflict=출처 불일치, 값 사용 금지 / unknown=어디에도 없음 / not_applicable=이 모델에 없는 개념. conflict와 unknown을 구별하는 것이 핵심이다 — 전자는 우리가 정리하지 못한 것이고 고칠 수 있다."
    },

    "confidence": {
      "enum": ["high", "medium", "low", "none"],
      "description": "high는 verified에만. medium은 documented 또는 base_model 상속. low는 inferred. unknown/conflict는 none. 모델명에서 숫자를 긁어내는 것은 어떤 등급도 아니며 금지한다 — Mistral-Small-4-119B-GGUF에서 정규식은 4B를 잡지만 실제는 119B다."
    },

    "source_ref": {
      "type": "string",
      "pattern": "^(hf_api|hf_file|hf_blob|model_card|readme|official_doc|derived_from|config):",
      "description": "출처는 자유 문자열이 아니다. hf_api:gguf.total / hf_file:config.json:max_position_embeddings / hf_blob:model-Q4_K_M.gguf / model_card:cardData.license / readme:table[1].row[64] / official_doc:<URL> / derived_from:<model_id>"
    },

    "fact_provenance": {
      "type": "object",
      "required": ["status", "confidence", "source"],
      "additionalProperties": false,
      "properties": {
        "status":       { "$ref": "#/$defs/status" },
        "confidence":   { "$ref": "#/$defs/confidence" },
        "source":       { "type": "array", "items": { "$ref": "#/$defs/source_ref" } },
        "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
        "note":         { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "description": "verified인데 출처가 비어 있으면 근거 없는 고신뢰 값이다. 추측이 승격된 것이다.",
          "if":   { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": { "properties": { "source": { "minItems": 1 }, "confidence": { "const": "high" } } }
        },
        {
          "description": "unknown과 conflict는 신뢰도가 없다.",
          "if":   { "properties": { "status": { "enum": ["unknown", "conflict"] } }, "required": ["status"] },
          "then": { "properties": { "confidence": { "const": "none" } } }
        },
        {
          "description": "inferred는 low를 넘지 않는다.",
          "if":   { "properties": { "status": { "const": "inferred" } }, "required": ["status"] },
          "then": { "properties": { "confidence": { "const": "low" }, "source": { "minItems": 1 } } }
        },
        {
          "description": "documented는 medium이고 출처가 있어야 한다.",
          "if":   { "properties": { "status": { "const": "documented" } }, "required": ["status"] },
          "then": { "properties": { "confidence": { "const": "medium" }, "source": { "minItems": 1 } } }
        }
      ]
    },

    "artifact_format": {
      "type": "object",
      "required": ["present", "file_count", "total_bytes", "shard_count", "quantization"],
      "additionalProperties": false,
      "properties": {
        "present":      { "type": "boolean" },
        "file_count":   { "type": ["integer", "null"], "minimum": 0 },
        "total_bytes":  { "type": ["integer", "null"], "minimum": 0, "description": "이 포맷 파일들의 크기 합. GGUF 양자화본은 이것이 Q2의 가장 정확한 근거다." },
        "shard_count":  { "type": ["integer", "null"], "minimum": 0 },
        "quantization": {
          "type": ["array", "null"],
          "description": "GGUF는 한 레포에 Q2_K~Q8_0이 여러 벌 들어 있다. 하나로 뭉개면 '4.1GB'인지 '27GB'인지 답할 수 없다.",
          "items": {
            "type": "object",
            "required": ["label", "total_bytes"],
            "additionalProperties": false,
            "properties": {
              "label":       { "type": "string", "description": "Q4_K_M, IQ3_XS, Q8_0 등" },
              "total_bytes": { "type": "integer", "minimum": 0 },
              "file_count":  { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      }
    },

    "deployment_target": {
      "type": "object",
      "required": ["status", "confidence", "evidence", "conditions"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["documented", "artifact_present", "tested", "inferred", "unknown"],
          "description": "documented=카드·공식 문서가 지원을 명시 / artifact_present=해당 포맷 파일이 실제로 있다 / tested=우리가 돌려 봤다 / inferred=가중치가 있으니 될 것이다 / unknown. Q3의 답변 문구가 이 등급에 따라 달라진다."
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence":   { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": ["string", "null"], "description": "'된다'고만 말하면 안 되는 조건. 사용자에게 함께 보여준다." }
      }
    },

    "contract_fields": {
      "description": "provenance.fields에 반드시 항목이 있어야 하는 사실 필드의 점 경로. validate.py가 이 목록을 읽는다. 사실이 아닌 그룹(semantic)과 유도 표시(legal.review_required/user_message)는 제외한다.",
      "const": [
        "identity.revision",
        "identity.last_modified",
        "identity.gated",
        "capability.primary_task",
        "capability.languages",
        "capability.korean_verified",
        "capability.translation_pairs",
        "capability.embedding_dimensions",
        "technical.architecture",
        "technical.model_type",
        "technical.parameter_count_total",
        "technical.parameter_count_active",
        "technical.context_length",
        "technical.dtype",
        "artifacts.total_bytes",
        "artifacts.formats.gguf",
        "artifacts.formats.safetensors",
        "deployment.vram_estimate",
        "legal.license_raw",
        "legal.license_file",
        "legal.commercial_status",
        "legal.base_model_constraint",
        "quality.results"
      ]
    }
  }
