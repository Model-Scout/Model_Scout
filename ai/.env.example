# Copy to ai/.env for AI scripts. The backend requires explicit process env / --env-file.

# Supabase (Postgres + pgvector)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_PASSWORD=

# OpenAI: embeddings and semantic metadata (still used with local generation)
OPENAI_API_KEY=
OPENAI_MODEL=

# Recommendation generation only: planner, explanation, follow-up questions.
# Local development: no paid generation calls and no fallback to OpenAI.
RECOMMEND_LLM_PROVIDER=ollama
RECOMMEND_LLM_MODEL=gemma3:4b
RECOMMEND_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Switch to GPT: set provider=openai, model=gpt-4.1-mini, then restart the AI server.
# RECOMMEND_LLM_BASE_URL is only used by the ollama provider.
# Optional: override only the recommendation summary and its pipeline, using the same provider.
# RECOMMEND_EXPLAIN_MODEL=gpt-4.1-mini

# Recommendation search (09, 17). Contract hard filters (license/artifact/file size/gated) need
# supabase_migration_contract_filters.sql in the database. Keep this off until the migration and the
# contract reingest are done; see ai/MODEL_REINGEST_RUNBOOK.md.
# MODEL_CONTRACT_FILTERS_ENABLED=false

# IDF-weighted sparse ranking. The score itself switches on the server: the function falls back to
# the old expression while model_scout_search_df is empty, so this flag only decides whether 17
# drops the task hard filter on benchmark questions. Turn it on after
# supabase_migration_sparse_idf.sql AND refresh_model_scout_search_df(); before that it costs a
# little recall. See ai/MODEL_REINGEST_RUNBOOK.md.
# MODEL_SPARSE_IDF_ENABLED=false

# Reranking the top candidates of a model search. Unset, it runs on gpt-4.1-mini when the
# generation provider is openai, and is skipped entirely on ollama because a 4B local model was
# never measured at this. Set a model name to rerank with that instead -- then the numbers in
# ai/model_rerank.py no longer describe it and should be re-measured.
# MODEL_RERANK_MODEL=

# Collection (pipeline only)
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
SEOUL_OPEN_API_KEY=
DATA_GO_KR_API_KEY=

# Backend server (optional)
# CORS_ORIGINS=http://localhost:3000
# THREAD_TTL_DAYS=30
