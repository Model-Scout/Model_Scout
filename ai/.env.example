# Copy to ai/.env for AI scripts. The backend requires explicit process env / --env-file.

# Supabase (Postgres + pgvector)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_PASSWORD=

# OpenAI: embeddings and semantic metadata (still used with local generation)
OPENAI_API_KEY=
OPENAI_MODEL=

# Recommendation generation only: planner, explanation, follow-up questions.
# Local development: no paid generation calls and no fallback to OpenAI.
RECOMMEND_LLM_PROVIDER=ollama
RECOMMEND_LLM_MODEL=gemma3:4b
RECOMMEND_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Switch to GPT: set provider=openai, model=gpt-4.1-mini, then restart the AI server.
# RECOMMEND_LLM_BASE_URL is only used by the ollama provider.

# Recommendation search (09, 17). Contract hard filters (license/artifact/file size/gated) need
# supabase_migration_contract_filters.sql in the database. Keep this off until the migration and the
# contract reingest are done; see ai/MODEL_REINGEST_RUNBOOK.md.
# MODEL_CONTRACT_FILTERS_ENABLED=false

# Collection (pipeline only)
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
SEOUL_OPEN_API_KEY=
DATA_GO_KR_API_KEY=

# Backend server (optional)
# CORS_ORIGINS=http://localhost:3000
# THREAD_TTL_DAYS=30
