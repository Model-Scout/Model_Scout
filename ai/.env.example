# Copy to ai/.env. Used by the ai/ pipeline and by the backend server (backend/app/main.py).

# Supabase (Postgres + pgvector)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_PASSWORD=

# OpenAI: embeddings, semantic metadata, recommendation answers
OPENAI_API_KEY=
OPENAI_MODEL=

# Recommendation search (09, 17). Contract hard filters (license/artifact/file size/gated) need
# supabase_migration_contract_filters.sql in the database. Keep this off until the migration and the
# contract reingest are done; see ai/MODEL_REINGEST_RUNBOOK.md.
# MODEL_CONTRACT_FILTERS_ENABLED=false

# Collection (pipeline only)
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
SEOUL_OPEN_API_KEY=
DATA_GO_KR_API_KEY=

# Backend server (optional)
# CORS_ORIGINS=http://localhost:3000
# THREAD_TTL_DAYS=30
