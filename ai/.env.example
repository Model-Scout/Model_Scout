# Copy to ai/.env. Used by the ai/ pipeline and by the backend server (backend/app/main.py).

# Supabase (Postgres + pgvector)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_PASSWORD=

# OpenAI: embeddings, semantic metadata, recommendation answers
OPENAI_API_KEY=
OPENAI_MODEL=

# Collection (pipeline only)
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
SEOUL_OPEN_API_KEY=
DATA_GO_KR_API_KEY=

# Backend server (optional)
# CORS_ORIGINS=http://localhost:3000
# THREAD_TTL_DAYS=30
