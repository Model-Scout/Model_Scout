# Reference only: the server does not read this file. Set these as process environment variables.
AI_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000
ENABLE_DOCS=1
DB_POOL_SIZE=4
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_PASSWORD=
SUPABASE_DB_SSLMODE=require
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_LIMIT=300
