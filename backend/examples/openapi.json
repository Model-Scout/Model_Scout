{
  "openapi": "3.1.0",
  "info": {
    "title": "Model Scout API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/chat": {
      "post": {
        "summary": "Chat",
        "description": "Ask a question. A query on a group waiting at `clarify` answers its questions.",
        "operationId": "chat_api_chat_post",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "crypto.randomUUID() kept in localStorage",
              "title": "X-Session-Id"
            },
            "description": "crypto.randomUUID() kept in localStorage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events. `status` and `token` repeat, then one `done` (the schema below) or one `error`. Swagger shows the stream only once it ends; use `curl -N` to watch it.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: status\ndata: {\"step\": 1, \"total\": 4, \"label\": \"요구사항 분석\", \"elapsed\": 2.4}\n\nevent: token\ndata: {\"text\": \"추천 \"}\n\nevent: done\ndata: {\"schema_version\": 2, \"type\": \"answer\", \"group_id\": \"00000000-0000-0000-0000-000000000001\", \"elapsed\": 14.1, \"answer\": \"추천 후보가 없습니다.\", \"sources\": [], \"result\": {\"title\": \"추천 결과\", \"summary\": [], \"needs_check\": [], \"candidates\": [], \"assessment\": null}, \"history_saved\": true}\n\n"
              }
            }
          },
          "403": {
            "description": "다른 세션의 대화"
          },
          "404": {
            "description": "없는 group_id"
          },
          "409": {
            "description": "해당 대화 처리 중 또는 질문할 추천 결과 없음"
          },
          "422": {
            "description": "요청 형식 오류 또는 유효하지 않은 질문 대상"
          },
          "503": {
            "description": "DB 미설정"
          },
          "429": {
            "description": "요청 제한 초과, Retry-After 헤더 참고"
          }
        }
      }
    },
    "/api/groups": {
      "get": {
        "summary": "List Groups",
        "description": "Conversations of this session, latest first.",
        "operationId": "list_groups_api_groups_get",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "crypto.randomUUID() kept in localStorage",
              "title": "X-Session-Id"
            },
            "description": "crypto.randomUUID() kept in localStorage"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GroupSummary"
                  },
                  "title": "Response List Groups Api Groups Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{group_id}": {
      "get": {
        "summary": "Get Group",
        "description": "A stored conversation. Readable by anyone holding the link; continuing it needs the same session.",
        "operationId": "get_group_api_groups__group_id__get",
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Group Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDetail"
                }
              }
            }
          },
          "404": {
            "description": "없는 group_id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{source_id}": {
      "get": {
        "summary": "Get File",
        "description": "README of a model or dataset.",
        "operationId": "get_file_api_files__source_id__get",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "result.sources[].source_id",
              "examples": [
                "openai/gsm8k"
              ],
              "title": "Source Id"
            },
            "description": "result.sources[].source_id"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "model",
                    "dataset"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceFile"
                }
              }
            }
          },
          "404": {
            "description": "원문 없음"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Candidate": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "model:<source_id> or dataset:<source_id>; target_id uses this value"
          },
          "type": {
            "type": "string",
            "enum": [
              "model",
              "dataset"
            ],
            "title": "Type"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array",
            "title": "Checks"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Related"
          },
          "rank_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank Score"
          },
          "context_length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Length"
          },
          "parameters_b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters B"
          },
          "benchmarks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Benchmarks"
          },
          "gpu_fit": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Fit"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "source_id",
          "name",
          "role",
          "source"
        ],
        "title": "Candidate"
      },
      "ChatRequest": {
        "properties": {
          "group_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Id",
            "description": "null starts a new conversation"
          },
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "examples": [
              "따릉이 경로 추천 서비스를 만들고 싶어"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "recommend",
              "question"
            ],
            "title": "Mode",
            "default": "recommend"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatRequest"
      },
      "ChatResult": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Summary"
          },
          "needs_check": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Needs Check"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "assessment": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assessment"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary",
          "candidates"
        ],
        "title": "ChatResult"
      },
      "Check": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "check",
              "unknown"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "origin": {
            "type": "string",
            "enum": [
              "readme",
              "metadata",
              "estimate",
              "unknown"
            ],
            "title": "Origin",
            "default": "unknown"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "status",
          "reason"
        ],
        "title": "Check"
      },
      "Evidence": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "origin": {
            "type": "string",
            "enum": [
              "readme",
              "metadata"
            ],
            "title": "Origin",
            "default": "metadata"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "Evidence",
        "description": "Why a dataset was recommended. Relevance only, so it is kept apart from condition checks."
      },
      "GroupDetail": {
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid",
            "title": "Group Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "group_id",
          "title",
          "created_at",
          "updated_at",
          "messages"
        ],
        "title": "GroupDetail"
      },
      "GroupSummary": {
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid",
            "title": "Group Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "group_id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "GroupSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answer",
                  "clarify",
                  "reject"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "Message"
      },
      "Source": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "model",
              "dataset"
            ],
            "title": "Kind"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "origin": {
            "type": "string",
            "enum": [
              "readme",
              "metadata",
              "estimate",
              "unknown"
            ],
            "title": "Origin",
            "default": "unknown"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "kind"
        ],
        "title": "Source"
      },
      "SourceFile": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "content"
        ],
        "title": "SourceFile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
